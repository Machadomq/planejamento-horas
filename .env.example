# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys). O ".env" NÃO vai para o GitHub.
#
# Tudo que começa com VITE_ vai para o navegador, ou seja, fica PÚBLICO.
# Por isso aqui entra SÓ a chave pública (publishable / anon).
# NUNCA coloque aqui a chave "secret" / "service_role".

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica
